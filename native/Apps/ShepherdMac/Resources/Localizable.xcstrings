    "newtask_agent_provider_codex_alpha_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Codex-Integration ist eine Alpha/MVP-Funktion und wird gerade intensiv weiterentwickelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex integration is an Alpha/MVP feature and is under heavy development."
          }
