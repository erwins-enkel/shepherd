      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum gestoppt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why stalled?"
          }
        }
      }
    },
    "plangate_menu_why_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Plan-Review-Schleife hat ihr Rundenlimit erreicht. Die Ausführung bleibt gesperrt, bis der Agent .shepherd-plan.md aktualisiert und der Plan freigegeben ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic plan-review loop reached its round limit. Execution stays locked until the agent updates .shepherd-plan.md and the plan is approved."
          }
        }
      }
    },
    "plangate_planning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PLANUNG"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PLANNING"
          }
        }
      }
    },
