    "newtask_agent_provider_codex_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex startet als interaktive Terminal-Session und läuft unbeaufsichtigt mit --dangerously-bypass-approvals-and-sandbox (Sandbox-Profil auf trusted gesetzt). Plan Gate ist verfügbar. Autopilot arbeitet nach bestem Bemühen (Alpha) und führt die zugeordnete Unterhaltung in beiden Checkout-Arten bis zu einem offenen PR. Die Modellauswahl verwendet Codex-CLI-Modelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex starts as an interactive terminal session, running unattended under --dangerously-bypass-approvals-and-sandbox (sandbox profile forced to trusted). Plan Gate is available. Autopilot is best-effort (Alpha) and drives the identified task conversation toward an open PR in either checkout mode. The model picker uses Codex CLI models."
          }
        }
      }
    },
    "newtask_agent_provider_codex_suggested_for_hold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist am Nutzungsrückhalt-Schwellenwert, daher umgeht das Ausführen dieser Aufgabe auf Codex den Rückhalt. Wechsle die Coding-CLI zurück zu Claude Code, um sie stattdessen bis zum Reset zurückzuhalten oder trotzdem einzureichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is at the usage-hold threshold, so running this task on Codex sidesteps the hold. Switch the coding CLI back to Claude Code to hold it until the reset or submit anyway instead."
          }
        }
      }
    },
