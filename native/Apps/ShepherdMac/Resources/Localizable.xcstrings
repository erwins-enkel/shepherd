      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Plandatei hat sich seit der Freigabe geändert. Eine erneute Prüfung lässt die Änderung kritisch gegenlesen — verlangt der Prüfer Änderungen, kehrt die Session in die Planungsphase zurück und der Agent hört auf zu implementieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan file has changed since this was approved. Re-review it to have the edit adversarially checked — if the reviewer requests changes, the session returns to planning and the agent stops implementing."
          }
        }
      }
    },
