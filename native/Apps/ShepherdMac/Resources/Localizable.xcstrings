    "diagnostics_hint_gitcap_old": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "git ≥ 2.38 nicht verfügbar — der Lightweight-Repo-Modus benötigt git merge-tree --write-tree (git ≥ 2.38) für lokale Merges. git fehlt möglicherweise (siehe git-Prüfung) oder ist zu alt; installiere oder aktualisiere es, um Lightweight-Repos zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git ≥ 2.38 not available — lightweight repo mode needs git merge-tree --write-tree (git ≥ 2.38) for local merges. git may be missing (see the git check) or too old; install or update it to use lightweight repos."
          }
        }
      }
    },
    "diagnostics_hint_herdr_health_leftover": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige herdr-Panes führen noch Prozesse aus, hinter denen keine aktive Shepherd-Sitzung steht — wahrscheinlich Überbleibsel abgeschlossener Aufgaben. Es wurde nichts verändert (nur Diagnose). Hinweis: Die „Tasks“-Zahl von systemd für herdr zählt [[herdr-hygiene|Threads, keine Prozesse]], eine hohe Zahl ist also für sich genommen kein Leck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some herdr panes are still running processes with no active Shepherd session behind them — likely leftovers from finished tasks. Nothing was touched (diagnose-only). Note: systemd's Tasks count for herdr reflects [[herdr-hygiene|threads, not processes]], so a high number there isn't itself a leak."
          }
        }
      }
    },
    "diagnostics_hint_herdr_health_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine übrig gebliebenen herdr-Panes — jedes aktive Pane gehört zu einer aktiven Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leftover herdr panes — every live pane maps to an active session."
          }
        }
      }
    },
    "diagnostics_hint_herdr_health_uninspectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd kann herdr gerade nicht erreichen, um die Laufzeithygiene zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd can't reach herdr to check runtime hygiene right now."
          }
        }
      }
    },
    "diagnostics_hint_herdr_missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr-Binary nicht im PATH gefunden — installiere es, um Agent-Sessions zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr binary not found in PATH — install it to run agent sessions."
          }
        }
      }
    },
    "diagnostics_hint_herdr_offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr ist installiert, aber sein Server ist offline — Agent-Sessions können nicht laufen. Starte ihn mit `herdr server` und führe die Diagnose erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr is installed but its server is offline — agent sessions can't run. Start it by running `herdr server`, then re-run Diagnose."
          }
        }
      }
    },
    "diagnostics_hint_herdr_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr ist aktuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr is up to date."
          }
        }
      }
    },
    "diagnostics_hint_herdr_outdated": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine herdr-Version liegt unter dem unterstützten Minimum — aktualisiere herdr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your herdr version is below the supported floor — update herdr."
          }
        }
      }
    },
    "diagnostics_hint_herdr_restart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierte herdr-Version und ihr laufender Server passen nicht zusammen. Schließe den Serverwechsel mit einem bestätigten Neustart ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed herdr and its running server do not match. Finish the server update with a confirmed restart."
          }
        }
      }
    },
    "diagnostics_hint_herdr_unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der herdr-Serverzustand konnte nicht geprüft werden. Öffne den Update-Dialog, um die Verbindung zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The herdr server state could not be verified. Open the update dialog to check the connection."
          }
        }
      }
    },
    "diagnostics_hint_herdr_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese herdr-Version ist neuer als von Shepherd unterstützt — das Starten von Agenten würde damit fehlschlagen. Nutze „herdr downgraden“, um mit einem Klick zur höchsten unterstützten Version zurückzukehren, oder fixiere herdr manuell (https://herdr.dev) und führe die Diagnose erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This herdr version is newer than Shepherd supports — agent spawning would fail on it. Use Downgrade herdr to return to the highest supported version in one click, or pin herdr manually (https://herdr.dev), then re-run Diagnose."
          }
        }
      }
    },
    "diagnostics_hint_host_capacity_herdr_unbounded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherds eigener Dienst ist begrenzt, aber der herdr-Dienst, der deine Agent-Sessions ausführt, hat keine Speicher- oder CPU-Obergrenze — eine außer Kontrolle geratene Session könnte den Host trotzdem auslasten. Setze auch für herdr ein [[host-capacity|Host-Kapazität]]-Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd's own service is bounded, but the herdr service that runs your agent sessions has no memory or CPU ceiling — a runaway session could still starve the host. Add a [[host-capacity|host capacity]] limit to herdr too."
          }
        }
      }
    },
    "diagnostics_hint_host_capacity_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host-Ressourcenlimits sind konfiguriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host resource guardrails are configured."
          }
        }
      }
    },
    "diagnostics_hint_host_capacity_pressure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host steht gerade unter Speicher- oder IO-Last — pausiere oder reduziere aktive Agent-Sessions, bis er sich erholt. „So behebst du das“ erklärt, wie du Limits setzt, damit das nicht erneut passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host is under memory or IO pressure right now — pause or reduce active agent sessions until it recovers. How to fix covers adding limits so it can't recur."
          }
        }
      }
    },
    "diagnostics_hint_host_capacity_unbounded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd läuft als systemd-Dienst ohne Speicher- oder CPU-Obergrenze, sodass ein Schwung an Sessions den Host auslasten könnte. Setze ein [[host-capacity|Host-Kapazität]]-Limit — „So behebst du das“ enthält einen fertigen Befehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd runs as a systemd service with no memory or CPU ceiling, so a burst of sessions could starve the host. Add a [[host-capacity|host capacity]] limit — How to fix has a copy-paste command."
          }
        }
      }
    },
    "diagnostics_hint_host_capacity_uninspectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd kann die Host-Ressourcenlimits auf diesem Deployment nicht prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd can't verify host resource guardrails on this deployment."
          }
        }
      }
    },
    "diagnostics_hint_node_missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "node nicht im PATH gefunden — installiere es, bevor du Aufgaben startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "node not found in PATH — install it before running tasks."
          }
        }
      }
    },
    "diagnostics_hint_node_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "node ist aktuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "node is up to date."
          }
        }
      }
    },
    "diagnostics_hint_node_outdated": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine node-Version liegt unter dem unterstützten Minimum — aktualisiere node."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your node version is below the supported floor — update node."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_idle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preview-Erkennung funktioniert, wird derzeit aber nicht genutzt — ohne aktive Session in einem Worktree hält Shepherd seine Sicht auf die laufenden Prozesse nicht aktuell. Sie wird aufgefrischt, sobald eine Session startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview detection works, but nothing is exercising it right now — with no active session in a worktree, Shepherd doesn't keep its view of running processes up to date. It refreshes as soon as a session starts."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd erkennt die von deinen Agenten gestarteten Dev-Server, daher funktionieren Live-Previews."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd can detect the dev servers your agents start, so live previews work."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_stale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherds Sicht auf die laufenden Prozesse ist auf diesem Host veraltet (die letzte Inspektion wurde nicht rechtzeitig abgeschlossen), daher können Live-Previews verzögert sein oder fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd's view of running processes is out of date on this host (the last inspection didn't complete in time), so live previews may be delayed or missing."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd kann laufende Prozesse auf diesem Host nicht inspizieren und daher die von deinen Agenten gestarteten Dev-Server nicht erkennen — Live-Previews erscheinen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd can't inspect running processes on this host, so it can't detect the dev servers your agents start — live previews won't appear."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_uninspectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd konnte nicht überprüfen, ob die Prozesserkennung auf diesem Host funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd couldn't verify whether process detection works on this host."
          }
        }
      }
    },
    "diagnostics_hint_preview_probes_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung von Live-Previews wird auf diesem Betriebssystem nicht unterstützt, daher erscheinen keine Previews."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live preview detection isn't supported on this operating system, so previews won't appear."
          }
        }
      }
    },
    "diagnostics_hint_pwa_android": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Shepherd für ein App-Symbol, eine Vollbild-Ansicht und ein Push-Abo, das die Speicherbereinigung des Browsers übersteht. Öffne das Browser-Menü → „App installieren“ / „Zum Startbildschirm hinzufügen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Shepherd for an app icon, a full-screen view, and a push subscription that survives the browser's storage cleanup. Open the browser menu → 'Install app' / 'Add to Home Screen'."
          }
        }
      }
    },
    "diagnostics_hint_pwa_ios": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iOS funktionieren Shepherds Push-Benachrichtigungen nur, wenn die App zum Home-Bildschirm hinzugefügt ist — in einem Safari-Tab bekommst du keine. Tippe auf „Teilen“ und dann „Zum Home-Bildschirm“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS, Shepherd's push notifications only work when it's installed to the Home Screen — in a Safari tab you get none. Tap the Share button, then 'Add to Home Screen'."
          }
        }
      }
    },
    "diagnostics_hint_pwa_optional": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd in diesem Browser zu installieren ist optional. Wo es unterstützt wird, ergänzt es ein App-Symbol, eine Vollbild-Ansicht und Push-Benachrichtigungen, die die Speicherbereinigung des Browsers überstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing Shepherd is optional in this browser. Where it's supported, it adds an app icon, a full-screen view, and push notifications that survive the browser's storage cleanup."
          }
        }
      }
    },
    "diagnostics_hint_sandbox_membrane_broken": {
      "comment": "%1$@ = agent",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ startet auf diesem Host nicht in der [[sandbox-membrane|Sandbox-Membran]]. Deshalb verweigern alle eingeschränkten Helfer — Plan-Prüfer, Pull-Request-Kritiker, Doku-Agent — den Start, statt bis zum Timeout zu hängen. Meist versucht ein Versionsmanager, Dateien zu überschreiben, die die Sandbox schreibgeschützt hält. Der genaue Fehler steht in Shepherds Log."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ does not start inside the [[sandbox-membrane|sandbox membrane]] on this host, so every confined helper — plan reviewer, pull-request critic, doc agent — refuses to start rather than hanging until it times out. Usually a version manager trying to rewrite files the sandbox keeps read-only. The exact error is in Shepherd's log."
          }
        }
      }
    },
    "diagnostics_hint_sandbox_membrane_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-Programme starten korrekt in der [[sandbox-membrane|Sandbox-Membran]], Prüfer und Kritiker können also eingeschränkt laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent programs start correctly inside the [[sandbox-membrane|sandbox membrane]], so reviewers and critics can run confined."
          }
        }
      }
    },
    "diagnostics_hint_sandbox_membrane_uninspectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd konnte nicht prüfen, ob Agent-Programme auf diesem Host in der [[sandbox-membrane|Sandbox-Membran]] starten. Eingeschränkte Helfer laufen weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd could not check whether agent programs start inside the [[sandbox-membrane|sandbox membrane]] on this host. Confined helpers still run."
          }
        }
      }
    },
    "diagnostics_hint_tailscale_missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale nicht installiert oder nicht angemeldet — installiere es und führe tailscale up aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale not installed or not logged in — install it and run tailscale up."
          }
        }
      }
    },
    "diagnostics_hint_tailscale_not_serving": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale läuft, stellt Shepherd aber nicht bereit — richte tailscale serve oder einen Tailscale-Service für den Remote-Zugriff ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is running but isn't fronting Shepherd — set up tailscale serve or a Tailscale Service for remote access."
          }
        }
      }
    },
    "diagnostics_hint_tailscale_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is connected."
          }
        }
      }
    },
    "diagnostics_hint_tailscale_serve_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale verweigert Shepherd die serve-Konfiguration, dadurch lässt sich keine Live-Vorschau veröffentlichen — führe einmalig sudo tailscale set --operator=$USER aus und prüfe die Checks erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale refuses Shepherd's serve config, so no live preview can be published — run sudo tailscale set --operator=$USER once, then re-run the checks."
          }
        }
      }
    },
    "diagnostics_hint_tmp_entries_critical": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das temporäre Dateisystem ist stark mit Überbleibseln zugesetzt — weit jenseits der Schwelle, ab der Shepherd aufräumt. Verzeichnis-Scans werden langsam, und die [[inode|Inodes]] können ausgehen, obwohl Speicherplatz frei aussieht. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary filesystem is badly cluttered with leftover entries — far past the point where Shepherd starts sweeping. Directory scans get slow and the filesystem can run out of [[inode|inodes]] while disk space still looks free. Fix sweeps the caches Shepherd can reclaim."
          }
        }
      }
    },
    "diagnostics_hint_tmp_entries_high": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im temporären Dateisystem sammeln sich Überbleibsel an. Es vergibt [[inode|Inodes]] dynamisch, deshalb beobachtet Shepherd die Anzahl statt einer Auslastung in Prozent. Unbeachtet verlangsamt das jeden Verzeichnis-Scan und kann die [[inode|Inodes]] trotzdem aufbrauchen. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leftover entries are piling up in the temporary filesystem. It allocates [[inode|inodes]] on demand, so Shepherd watches the count rather than a usage percentage. Left alone this slows every scan of those directories and can still exhaust the filesystem's [[inode|inodes]]. Fix sweeps the caches Shepherd can reclaim."
          }
        }
      }
    },
    "diagnostics_hint_tmp_entries_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das temporäre Dateisystem vergibt [[inode|Inodes]] dynamisch — eine Auslastung in Prozent gibt es dort nicht. Shepherd beobachtet stattdessen, wie viele Überbleibsel sich ansammeln. Aktuell unbedenklich wenige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary filesystem allocates [[inode|inodes]] on demand, so there is no usage percentage to read — Shepherd watches how many leftover entries pile up instead. Few enough to be healthy."
          }
        }
      }
    },
    "diagnostics_hint_tmp_inodes_critical": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im temporären Dateisystem sind die [[inode|Inodes]] fast aufgebraucht. Neue Agent-Sessions werden mit „kein Speicherplatz“-Fehlern scheitern, obwohl Speicherplatz frei aussieht. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary filesystem is nearly out of [[inode|inodes]]. New agent sessions will start failing with \"no space\" errors even though disk space looks free. Fix sweeps the caches Shepherd can reclaim."
          }
        }
      }
    },
    "diagnostics_hint_tmp_inodes_high": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im temporären Dateisystem werden die [[inode|Inodes]] knapp — es kann volllaufen, obwohl noch Speicherplatz frei ist, und Agent-Sessions scheitern dann mit irreführenden „kein Speicherplatz“-Fehlern. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary filesystem is running low on [[inode|inodes]] — it can run out while still showing free space, and agent sessions then fail with confusing \"no space\" errors. Fix sweeps the caches Shepherd can reclaim."
          }
        }
      }
    },
    "diagnostics_hint_tmp_inodes_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das temporäre Dateisystem hat reichlich freie [[inode|Inodes]]."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary filesystem has plenty of [[inode|inodes]] free."
          }
        }
      }
    },
    "diagnostics_hint_tmp_inodes_uninspectable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd kann die [[inode|Inode]]-Auslastung des temporären Dateisystems auf diesem System nicht auslesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd can't read [[inode|inode]] usage for the temporary filesystem on this deployment."
          }
        }
      }
    },
