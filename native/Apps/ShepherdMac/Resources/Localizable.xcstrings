        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein konfiguriertes Codex-Modell wird von deinem ChatGPT-Account-Login für Codex nicht unterstützt und durch den Account-Standard ersetzt. Wähle ein unterstütztes Modell oder melde dich bei Codex mit einem API-Key an."
          }
        },
