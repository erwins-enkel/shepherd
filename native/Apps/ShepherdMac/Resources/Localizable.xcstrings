    "model_guidance_claude_fable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die härtesten, langlaufenden Aufgaben. Höchste Qualität, höchste unbeaufsichtigte Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use for the hardest long-running work. Highest quality, highest unattended burn."
          }
        }
      }
    },
    "model_guidance_claude_fable_5_1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiert genau Fable 5.1, damit ein künftiges Fable-Release dieses Modell nicht still ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins Fable 5.1 exactly, so a future Fable release can't quietly change this model."
          }
        }
      }
    },
    "model_guidance_claude_haiku": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Günstig und schnell. Gut für Naming und Klassifizierer, schwach für primäres Coding."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheap and fast. Best for naming and classifiers, weak for primary coding."
          }
        }
      }
    },
    "model_guidance_claude_opus": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer das neueste Opus. Für PR-Kritik, Planung oder riskante Refactors, die mehr Urteilsvermögen als Sonnet brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always the latest Opus. Use for PR criticism, planning, or risky refactors that need stronger judgment than Sonnet."
          }
        }
      }
    },
    "model_guidance_claude_opus_1m": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuestes Opus mit 1 Mio. Kontext. Nur wählen, wenn Transcript oder Repo-Kontext das wirklich brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest Opus with 1M context. Use only when the transcript or repo context truly needs it."
          }
        }
      }
    },
    "model_guidance_claude_opus_5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiert genau Opus 5, damit ein künftiges Opus-Release dieses Modell nicht still ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins Opus 5 exactly, so a future Opus release can't quietly change this model."
          }
        }
      }
    },
    "model_guidance_claude_opus_5_1m": {
      "extractionState": "manual",
