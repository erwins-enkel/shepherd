    "native_banner_client_too_old": {
      "comment": "%1$@ = minimum, %2$@ = app",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server benötigt App-Version %1$@ oder neuer — du hast %2$@. Aktualisiere Shepherd für Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server needs app version %1$@ or newer — you have %2$@. Update Shepherd for Mac."
          }
        }
      }
    },
    "native_banner_mismatch": {
      "comment": "%1$@ = serverVersion, %2$@ = appVersion",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server- und App-Version unterscheiden sich — Server %1$@, App %2$@. Manches funktioniert möglicherweise nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server and app versions differ — server %1$@, app %2$@. Some things may not work."
          }
        }
      }
    },
    "native_banner_needs_login": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired. Sign in again."
          }
        }
      }
    },
    "native_banner_offline": {
      "comment": "%1$@ = server",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nicht erreichbar. Neuer Versuch läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach %1$@. Retrying."
          }
        }
      }
    },
    "native_detail_no_selection": {
      "extractionState": "manual",
      "localizations": {
