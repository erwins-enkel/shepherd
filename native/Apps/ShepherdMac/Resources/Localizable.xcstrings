    "native_error_forbidden": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat diese Anfrage abgelehnt. Melde dich erneut mit dem Operator-Passwort an."
