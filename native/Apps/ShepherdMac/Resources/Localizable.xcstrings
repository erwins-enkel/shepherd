      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent stoppt und der Worktree wird freigegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent stops and the worktree is released."
