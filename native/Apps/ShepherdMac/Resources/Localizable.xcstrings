    "model_guidance_auto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto lässt Shepherd manuelle Aufgaben vorbelegen, während unbeaufsichtigte Starts auf dem Provider-Standard bleiben."
          }
        },
