      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd hat die Limits angewendet, aber der Check ist weiterhin nicht OK — gib ihm einen Moment oder prüfe, ob die Unit benutzerbezogen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd applied the limits, but the check is still not OK — give it a moment, or check the unit is user-scoped."
          }
        }
      }
    },
    "diagnostics_fix_unresolved_tmp_inodes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd hat die freigebbaren Caches aufgeräumt, aber die Auslastung ist weiterhin hoch — der Rest ist höchstwahrscheinlich ein Paketmanager-Store oder ein zurückgelassener Worktree im temporären Dateisystem, den Shepherd noch nicht freigibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd swept the caches it can reclaim, but usage is still high — the rest is most likely a package-manager store or a leftover worktree an agent left in the temporary filesystem, which Shepherd doesn't reclaim yet."
          }
        }
      }
