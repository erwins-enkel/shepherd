{
  "name": "ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:demo": "SHEPHERD_DEMO=1 vite dev",
    "build": "vite build && bun scripts/precompress.ts build",
    "build:demo": "SHEPHERD_DEMO=1 vite build && bun scripts/precompress.ts build-demo",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prepare": "svelte-kit sync || echo '' && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:docs": "bun run scripts/gen-docs-manifest.ts",
    "check:docs-manifest": "bun run scripts/gen-docs-manifest.ts --check",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "is-reference": "^3.0.3",
    "magic-string": "^1.4.5",
    "periscopic": "^4.0.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0",
    "zimmerframe": "^1.1.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@pierre/diffs": "1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "shiki": "^4.5.0",
    "svelte-dnd-action": "^0.9.80",
    "uqr": "0.1.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
