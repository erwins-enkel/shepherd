    "newtask_sandbox_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox-Override pro Aufgabe. Bei 'Repo-Standard' wird das konfigurierte Profil dieses Repos übernommen. standard/autonom sperren den Agenten in sein Worktree ein und blockieren ~/.ssh, ~/.aws und andere $HOME-Dotfiles. Autonom fügt zudem die Egress-Allowlist hinzu (Anthropic + den Forge-Host) und blockiert anderen ausgehenden Verkehr; Standard lässt das Netzwerk offen (rein interaktiv). Die gh-/claude-Auth-Tokens bleiben lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-task sandbox override. Leave at 'Repo default' to inherit this repo's configured profile. standard/autonomous confine the agent to its worktree and block ~/.ssh, ~/.aws, and other $HOME dotfiles. Autonomous also adds the egress allowlist (Anthropic + the forge host), blocking other outbound; Standard leaves network open (interactive-only). The gh/claude auth tokens stay readable."
          }
        }
      }
    },
