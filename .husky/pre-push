#!/usr/bin/env sh
# Local lint, type/build and consistency checks in bounded parallel lanes.
# Run affected tests explicitly before pushing. Full suites (including browser tests)
# and the full CLI gate run in CI; do not mirror them into this hook.
# Prettier/eslint use the delta vs origin/main; docs-only deltas skip type/build lanes.
# See scripts/pre-push.ts for the local lane definitions and CI differences.
set -e

# Git exports GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE / … into hooks. Those leak
# into the test suite's `git` subprocesses and make repo-discovery tests believe
# they're inside this repo (e.g. worktree fallback tests fail, and worse, mutate
# the real repo). Scrub the repo-local set BEFORE exec so the orchestrator and every
# child it spawns run in the same clean env as CI.
unset $(git rev-parse --local-env-vars) 2>/dev/null || true

exec bun scripts/pre-push.ts
