    "diagnostics_hint_claude_install_diverged": {
      "comment": "%1$@ = running, %2$@ = managed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd startet Claude Code %1$@, mise verwaltet aber %2$@ — zwei Installationen, die auseinandergelaufen sind. Der Auto-Updater von Claude Code schreibt eine native Kopie nach ~/.local/bin/claude, die die von mise überdeckt, sodass mise upgrade claude nur die Installation bewegt, die niemand ausführt. Entferne die native Kopie, damit die von mise wieder im PATH liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd spawns Claude Code %1$@, but mise manages %2$@ — two installs that have drifted apart. Claude Code's auto-updater writes a native copy to ~/.local/bin/claude that shadows the mise one, so mise upgrade claude moves only the install nothing runs. Remove the native copy so mise's is back on PATH."
          }
        }
      }
    },
    "diagnostics_hint_claude_install_native_on_path": {
      "comment": "%1$@ = running",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd startet Claude Code aus einer nativen Installation, nicht aus der von mise verwalteten. Beide melden heute %1$@, sie laufen aber auseinander, sobald eine Seite aktualisiert wird, und mise upgrade claude bewegt dann nur die Kopie, die niemand ausführt. Entferne die native Kopie aus ~/.local/bin, damit die von mise wieder im PATH liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd spawns Claude Code from a native install, not the one mise manages. Both report %1$@ today, but they will drift as soon as either side updates, and mise upgrade claude will move only the copy nothing runs. Remove the native copy from ~/.local/bin so mise's is back on PATH."
          }
        }
      }
    },
    "diagnostics_hint_claude_install_native_residue": {
      "comment": "%1$@ = count, %2$@ = size",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mise verwaltet das Claude Code, das Shepherd startet, aber eine native Installation liegt noch auf der Platte: %1$@ Build(s), %2$@. Der Auto-Updater von Claude Code hat sie angelegt, bevor mise übernommen hat; sie wird nicht ausgeführt und kann gefahrlos gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mise manages the Claude Code that Shepherd spawns, but a leftover native install is still on disk: %1$@ build(s), %2$@. Claude Code's auto-updater put it there before mise took over; nothing runs it and it is safe to delete."
          }
        }
      }
    },
    "diagnostics_hint_claude_install_ok": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mise verwaltet das Claude Code, das Shepherd startet, und es liegt keine übrig gebliebene native Installation auf der Platte. Shepherd deaktiviert hier den Auto-Updater von Claude Code für Agent-Sessions, damit keine zweite Kopie angelegt wird; aktualisiere mit mise upgrade claude."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mise manages the Claude Code that Shepherd spawns, and no leftover native install is on disk. Shepherd disables Claude Code's auto-updater for agent sessions here so it can't plant a second copy; update with mise upgrade claude."
          }
        }
      }
    },
