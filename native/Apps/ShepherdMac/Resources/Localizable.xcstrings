    "plangate_repair_sent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan-Änderungen an den Agenten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan changes sent to the agent."
          }
        }
      }
    },
    "plangate_repair_steer": {
      "comment": "%1$@ = findings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere .shepherd-plan.md anhand der folgenden Plan-Review-Befunde. Beginne noch nicht mit der Implementierung. Wenn die Plan-Datei aktualisiert ist, halte an und sag mir, dass sie für eine erneute Plan-Prüfung bereit ist.\n\nAngeforderte Änderungen:\n%1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update .shepherd-plan.md to address the plan-review findings below. Do not start implementation yet. When the plan file is updated, stop and tell me it is ready for another plan review.\n\nRequested changes:\n%1$@"
          }
        }
      }
    },
    "plangate_review_at_cap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan-Prüfung gestartet, aber das Überarbeitungsbudget ist aufgebraucht: Verlangt der Prüfer Änderungen, werden diese Befunde nicht an den Agenten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan review started, but the rework budget is spent: if it requests changes, those findings won't be sent to the agent."
          }
        }
      }
    },
    "plangate_review_skipped_stalled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planprüfung konnte gerade nicht gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start a plan review right now."
          }
        }
      }
    },
    "plangate_review_spends_round": {
      "comment": "%1$@ = round, %2$@ = cap",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erneute Prüfung sendet die Befunde an den Agenten und verbraucht eine Überarbeitungsrunde (%1$@/%2$@ verbraucht)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reviews send the findings back to the agent and spend a rework round (%1$@/%2$@ used)."
          }
        }
      }
    },
