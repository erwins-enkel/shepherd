---
// The "how it works" pipeline animation — a ~17s, silent, autoplay, looping
// story styled as a live instrument readout (mission telemetry, not
// decoration). A single task token glides a gated pipeline — left → right on
// wide panels, top → bottom on narrow ones — pausing only where it matters
// (the plan gate, then CI and review running side by side), while ghost
// tasks flow on parallel lanes so the board always reads as live. Colour is
// semantic, from global.css tokens: --blue = the task in motion, --green =
// passed / landed, --amber = paused / needs-you, --ink-dim = inert structure.
//
// Thesis: Shepherd runs many agents at once (the parallel lanes flow the whole
// time) and is built to stop (near the end the task on the innermost lane
// bounces off a gate, turns amber, asks for you, while the others keep
// flowing).
//
// Stage: plain HTML/CSS, not SVG. Static structure (rails, gate posts,
// station boxes, terminal, labels as real text) is painted once. Station
// positions are 0..1 fractions along the track (--p-*), the single source of
// truth for both placement and token travel; --ax/--ay (1/0 horizontal, 0/1
// vertical) pick the axis, so the vertical layout only swaps those and the
// cross-axis lines (--c-*) and the same @keyframes drive both. Layouts switch
// on the panel's own width in rem (container queries), so a larger root font
// or browser default font size moves the switch exactly like a narrower
// screen would: vertical below 34.8rem (≈ a 40em viewport), compact vertical
// below 17.5rem (320px phones, or 390px at a 20px root font) so labels never
// clip. A token is a thin "carrier" spanning the track (cross size = the dot)
// with its dot at the start, moved by translate(p × 100%). A gate post sits
// --g past its p, so a token held at p rests against it.
//
// Perf contract: every @keyframes animates transform and opacity only — never
// colour, size, position, filter or custom properties. Colour changes
// (gate grey → amber → green, gate grey → blue running → green, blocked
// token blue → amber, pass flares) are crossfades of stacked elements; glows
// are static (rasterised once) and only on live-signal elements (tokens,
// check, landing pulse, needs-you chip). The loop therefore runs on the
// compositor: no per-frame paint or layout.
//
// One shared ~17s master timeline: every beat-driven element (class "m") uses
// the same duration + infinite iteration, so the beats stay in step and the
// loop restarts as one (the diff lines add 0.2–0.6s stagger delays on top).
// Windows are weighted, not uniform — the wordy beats (4 and 6) get more time
// so their captions stay readable, while the short beats stay snappy. Ambient
// motion (ghost tasks, cursor, live pip) runs on its own short clocks. The
// beat → % map below is the single source of truth; the beat rail in the
// chrome strip mirrors it.
//
//   Beat                          window (% of ~17s loop)
//   1 issue                         0 – 11
//   2 worktree + terminal          11 – 21
//   3 many at once (lanes brighten)21 – 29
//   4 plan, then stop (review)     29 – 48
//   5 work / diff                  48 – 56
//   6 CI ∥ review (in parallel)    56 – 71
//   7 land                         71 – 82
//   8 payload (bounce / needs you) 82 – 100
//
// Playback: on load the script below pauses every figure animation at t=0
// (beat 1); an IntersectionObserver restarts them from 0 once the caption is
// fully in view after the figure has been fully hidden (including the first
// time), and they rewind and pause once the figure is fully hidden — so a
// visitor starts on beat 1, not mid-story. The observer is only attached
// while paused: measured on this figure, a live one made Chromium run a
// main-thread style pass on every compositor frame. While playing, a passive
// scroll/resize check spots the exit. With JS disabled the CSS simply plays
// from load.
//
// Accessibility: the animated figure is role="img" with a full aria-label, so
// AT reads the summary and ignores the decorative internals. Under
// prefers-reduced-motion nothing animates (the motion rules only exist under
// no-preference): the same stage shows a frozen summary pose (every station,
// the merge node landed green, the blocked task amber with its chip), captions
// and beat rail hide, and an ordered list of the eight beats — outside the
// role="img", so AT reads it — appears below. Under forced colors (Windows
// contrast themes) the figure keeps its own palette, as the SVG it replaced
// did (backgrounds would otherwise be forced away); the list still adapts.
// Tokens only — no raw hex / rgba / ad-hoc px font sizes.

const beats: string[] = [
  "It starts as an issue.",
  "Its own worktree. Its own real terminal.",
  "A dozen of these at once.",
  "It writes a plan — and stops. A second agent tries to refute it.",
  "Then it works.",
  "CI. Hygiene. And alongside, a third agent reads the diff.",
  "Only what survives lands.",
  "And when it can't, it stops and tells you why.",
];

const ariaSummary =
  "A task starts as an issue and gets its own worktree and real terminal. " +
  "Many run in parallel. Each one writes a plan and stops while a second agent " +
  "reviews it in a separate clean copy of the repo; only then does it work. " +
  "Its diff then runs CI and hygiene checks while a third agent reviews it in " +
  "parallel; it lands only once both pass. And when a task can't pass, it " +
  "stops and asks for you — while the other tasks keep running.";

// Beat window lengths (% of the loop), from the map above — the beat rail's
// segment widths, so its fill advances at one steady speed.
const windows = [11, 10, 8, 19, 8, 15, 11, 18];

// Lanes 1–3 carry ghost tasks on their own linear clocks (two per lane, half a
// lap apart); lane 4, next to the hero lane, belongs to the blocked task.
// `rest` = where each ghost sits in the frozen reduced-motion pose.
const ghosts = [
  { lane: 1, dur: 10.5, lag: 0, rest: 0.31 },
  { lane: 1, dur: 10.5, lag: 5.25, rest: 0.88 },
  { lane: 2, dur: 12.5, lag: 2.1, rest: 0.55 },
  { lane: 2, dur: 12.5, lag: 8.35, rest: 0.17 },
  { lane: 3, dur: 9.5, lag: 3.9, rest: 0.76 },
  { lane: 3, dur: 9.5, lag: 8.65, rest: 0.36 },
];
const lanes = [1, 2, 3, 4];
const gates = ["plan", "checks", "review"];
---

<figure class="pipe">
  <div class="pipe-anim" role="img" aria-label={ariaSummary}>
    <div class="chrome" aria-hidden="true">
      <span class="live"><i class="pip"></i>task pipeline</span>
      <span class="beat-rail">
        {
          windows.map((w, i) => (
            <i class="seg" style={`--w:${w}`}>
              <b class={`m fill fill-${i + 1}`} />
            </i>
          ))
        }
      </span>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="frame">
        <!-- beat 3: parallel lanes — the "many at once", always flowing.
             Ticks line up with the hero lane's three gates. -->
        <div class="m lanes">
          {lanes.map((l) => <i class={`span ln lane l${l}`} />)}
          {
            lanes.map((l) =>
              gates.map((g) => <i class={`span xs tick l${l} at-${g}`} />),
            )
          }
          {
            ghosts.map((g) => (
              <i
                class={`car ghost l${g.lane}`}
                style={`--dur:${g.dur}s;--lag:-${g.lag}s;--rest:${g.rest}`}>
                <i class="dot" />
              </i>
            ))
          }
        </div>
        <i class="span xs trunk"></i>
        <i class="span ln rail"></i>

        <!-- beat 5: the diff draws in beside the working token;
             beat 6: the third agent's scan reads it while CI runs -->
        <div class="span diffs">
          <i class="m diff d1"></i>
          <i class="m diff d2"></i>
          <i class="m diff d3"></i>
          <i class="m diff d4"></i>
          <i class="m diff-scan"></i>
        </div>

        <!-- beat 6: clear flares (under the posts) -->
        <span class="pt gated on-rail at-checks"><i class="m flare flare-checks"></i></span>
        <span class="pt gated on-rail at-review"><i class="m flare flare-review"></i></span>

        <!-- beat 4: plan gate — holds amber, turns green, opens (halves part) -->
        <span class="pt gate plan-gate gated on-rail at-plan">
          <i class="m half up"><i class="m pg-green"></i></i>
          <i class="m half down"><i class="m pg-green"></i></i>
          <i class="m pg-amber"></i>
        </span>
        <!-- beat 6: checks and review run at once (blue), then clear green -->
        <span class="pt gate gated on-rail at-checks">
          <i class="m g-run run-checks"></i>
          <i class="m g-green g-checks"></i>
        </span>
        <span class="pt gate gated on-rail at-review">
          <i class="m g-run run-review"></i>
          <i class="m g-green g-review"></i>
        </span>

        <!-- hero token: under the station boxes, so it slips inside them -->
        <i class="m car tok on-rail"><i class="dot"></i></i>

        <!-- beat 1: issue card -->
        <span class="pt card on-rail at-issue">
          <span class="m label-chip">shepherd:auto</span>
          <i class="txt"></i>
          <i class="txt short"></i>
          <i class="m lit lit-issue"></i>
        </span>

        <!-- beat 2: worktree + live terminal -->
        <span class="pt wt on-rail at-wt">
          <span class="term">
            <i class="code"></i>
            <i class="code long"></i>
            <i class="cursor"></i>
          </span>
          <i class="m lit lit-wt"></i>
        </span>

        <!-- beat 7: merge trunk node -->
        <span class="pt merge on-rail at-merge">
          <i class="m mg-green"></i>
          <i class="m land"></i>
        </span>

        <!-- beat 4: separate clean-copy reviewer, in its own clear zone -->
        <span class="pt cc-at gated at-plan">
          <span class="m cc">
            <span class="cc-h">clean copy</span>
            <span class="cc-body">
              <i class="code"></i>
              <i class="code long"></i>
              <i class="code"></i>
              <i class="m scan"></i>
            </span>
            <i class="m verdict"><i></i></i>
            <i class="cc-stem"></i>
          </span>
        </span>

        <!-- beat 8: the lane-4 task bounces off a gate, turns amber, asks -->
        <i class="m car blocked l4">
          <i class="dot"></i>
          <i class="m dot amber"></i>
          <i class="m ping"></i>
        </i>
        <span class="pt needs-at"><span class="m needs">needs you</span></span>

        <!-- station labels: one shared baseline (one shared column when vertical) -->
        <span class="pt lbl at-issue">issue</span>
        <span class="pt lbl at-wt">worktree</span>
        <span class="pt lbl gated at-plan">plan</span>
        <span class="pt lbl gated at-checks">checks</span>
        <span class="pt lbl gated at-review">review</span>
        <span class="pt lbl at-merge">merge</span>
      </div>
    </div>

    <p class="caption" aria-hidden="true">
      {beats.map((b, i) => <span class={`m beat beat-${i + 1}`}>{b}</span>)}
    </p>
  </div>

  <!-- Real content, shown only under prefers-reduced-motion -->
  <ol class="beat-list">
    {beats.map((b) => <li>{b}</li>)}
  </ol>
</figure>

<style>
  .pipe {
    --struct: color-mix(in srgb, var(--ink-dim) 55%, transparent);
    --struct-dim: color-mix(in srgb, var(--ink-dim) 40%, transparent);
    --line: color-mix(in srgb, var(--ink-dim) 70%, transparent);
    --post-c: color-mix(in srgb, var(--ink-dim) 85%, transparent);
    --box: color-mix(in srgb, var(--ink-dim) 8%, var(--bg));
    --code: color-mix(in srgb, var(--ink-dim) 90%, transparent);
    container: pipe / inline-size;
    margin: 0;
    width: 100%;
    overflow: clip;
    background: radial-gradient(
      120% 140% at 50% 0%,
      color-mix(in srgb, var(--green) 5%, var(--panel)) 0%,
      var(--panel) 55%
    );
    border: 1px solid var(--panel-2);
    border-radius: 0.9rem;
    padding: clamp(0.9rem, 2.6vw, 1.4rem);
  }

  /* ---------- instrument chrome strip ---------- */
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
  }
  .pip {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 6px color-mix(in srgb, var(--green) 70%, transparent);
  }
  /* beat rail: one segment per beat, widths = window lengths */
  .beat-rail {
    display: flex;
    gap: 3px;
    width: clamp(6rem, 16vw, 9.5rem);
  }
  .seg {
    flex: var(--w) 1 0;
    height: 3px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--struct-dim);
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--ink-muted);
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* ============================================================
     Stage geometry. Track space: main axis = a 0..1 fraction of the
     frame (--p, plus an optional length --o); cross axis = a length
     (--c) from the stage's top (horizontal) / left (vertical).
     ============================================================ */
  .stage {
    --ax: 1;
    --ay: 0;
    /* where the hero token stops or passes (fraction of the track) */
    --p-wt: 0.27;
    --p-plan: 0.42;
    --p-work: 0.53;
    --p-checks: 0.65;
    --p-review: 0.79;
    --p-ls: 0.07; /* ghost lanes start */
    --p-brest: calc(var(--p-checks) - 0.035); /* blocked task's rebound */
    --g: 0.5rem; /* gate post offset past its p */
    --post: 1.1rem; /* half length of a gate post */
    --card-w: 7rem;
    --wt-w: 7.5rem;
    --lbl-size: 0.8125rem;
    /* cross-axis lines */
    --c-l1: 0.7rem;
    --c-l2: 1.65rem;
    --c-l3: 2.6rem;
    --c-l4: 3.55rem;
    --c-rail: 9.55rem;
    --c-lbl: calc(var(--c-rail) + 2.35rem);
    --c-cc: calc(var(--c-rail) - 2.2rem); /* clean copy's track-facing edge */
    --c-chip: calc(var(--c-l4) + 0.75rem); /* clears the ping's full radius */
    --c-diff0: calc(var(--c-rail) + 0.55rem);
    --c-diff1: calc(var(--c-rail) + 1.95rem);
    --d-ghost: 0.5rem;
    --tick: 0.3rem; /* half length of a lane's gate tick */
    --ping: 1.3rem;
    --lane-dir: to right;
    --cross-dir: to bottom;
    position: relative;
    height: calc(var(--c-lbl) + 1.35rem);
  }
  /* frame = the track's extent: p 0 = issue centre, p 1 = merge node.
     Insets = half the issue card / half the "merge" label (5 mono glyphs
     × 0.6em advance ÷ 2 = 1.5em of the label size), so the diagram's
     outer edges sit equally far from the panel's. */
  .frame {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--card-w) / 2);
    right: calc(var(--lbl-size) * 1.5);
  }

  .at-issue {
    --p: 0;
  }
  .at-wt {
    --p: var(--p-wt);
  }
  .at-plan {
    --p: var(--p-plan);
  }
  .at-checks {
    --p: var(--p-checks);
  }
  .at-review {
    --p: var(--p-review);
  }
  .at-merge {
    --p: 1;
  }
  .gated {
    --o: var(--g);
  }
  .on-rail {
    --c: var(--c-rail);
  }
  .l1 {
    --c: var(--c-l1);
  }
  .l2 {
    --c: var(--c-l2);
  }
  .l3 {
    --c: var(--c-l3);
  }
  .l4 {
    --c: var(--c-l4);
  }

  /* point anchor at (p, c), centred unless told otherwise */
  .pt {
    position: absolute;
    left: calc(var(--ax) * (var(--p) * 100% + var(--o, 0rem)) + var(--ay) * var(--c));
    top: calc(var(--ay) * (var(--p) * 100% + var(--o, 0rem)) + var(--ax) * var(--c));
    translate: -50% -50%;
  }
  /* box from (p0 + o0, c0) to (p1 + o1, c1) */
  .span {
    position: absolute;
    left: calc(var(--ax) * (var(--p0) * 100% + var(--o0, 0rem)) + var(--ay) * var(--c0));
    top: calc(var(--ay) * (var(--p0) * 100% + var(--o0, 0rem)) + var(--ax) * var(--c0));
    width: calc(
      var(--ax) * ((var(--p1) - var(--p0)) * 100% + var(--o1, 0rem) - var(--o0, 0rem)) +
        var(--ay) * (var(--c1) - var(--c0))
    );
    height: calc(
      var(--ay) * ((var(--p1) - var(--p0)) * 100% + var(--o1, 0rem) - var(--o0, 0rem)) +
        var(--ax) * (var(--c1) - var(--c0))
    );
  }
  /* .ln: a line along the track at c; .xs: a line across it at p */
  .ln {
    --c0: calc(var(--c) - var(--t) / 2);
    --c1: calc(var(--c) + var(--t) / 2);
  }
  .xs {
    --p0: var(--p);
    --p1: var(--p);
    --o0: calc(var(--o, 0rem) - var(--t) / 2);
    --o1: calc(var(--o, 0rem) + var(--t) / 2);
  }
  /* token carrier: spans the whole track, the dot sits at its start */
  .car {
    --x: calc(var(--ax) * 100%);
    --y: calc(var(--ay) * 100%);
    position: absolute;
    left: calc(var(--ay) * (var(--c) - var(--d) / 2));
    top: calc(var(--ax) * (var(--c) - var(--d) / 2));
    width: calc(var(--ax) * 100% + var(--ay) * var(--d));
    height: calc(var(--ay) * 100% + var(--ax) * var(--d));
  }
  .dot {
    position: absolute;
    left: calc(var(--ax) * var(--d) / -2);
    top: calc(var(--ay) * var(--d) / -2);
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
  }

  /* ---------- static structure ---------- */
  .lanes {
    position: absolute;
    inset: 0;
    opacity: 0.6;
  }
  .lane {
    --p0: var(--p-ls);
    --p1: 1;
    --t: 1px;
    background: linear-gradient(var(--lane-dir), transparent, var(--struct) 2.5rem);
  }
  .tick {
    --o: var(--g);
    --t: 1.5px;
    --c0: calc(var(--c) - var(--tick));
    --c1: calc(var(--c) + var(--tick));
    background: var(--struct);
  }
  .trunk {
    --p: 1;
    --t: 2px;
    --c0: calc(var(--c-l1) - 0.45rem);
    --c1: var(--c-rail);
    background: var(--struct);
  }
  .rail {
    --p0: 0;
    --p1: 1;
    --c: var(--c-rail);
    --t: 1.5px;
    background: var(--struct);
  }

  .gate {
    width: calc(var(--ax) * 3px + var(--ay) * 2 * var(--post));
    height: calc(var(--ay) * 3px + var(--ax) * 2 * var(--post));
    border-radius: 2px;
    background: var(--post-c);
  }
  .plan-gate {
    background: none;
  }
  .half {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--ax) * 100% + var(--ay) * 50%);
    height: calc(var(--ay) * 100% + var(--ax) * 50%);
    border-radius: 2px;
    background: var(--post-c);
  }
  .half.up {
    --dir: -1;
  }
  .half.down {
    --dir: 1;
    left: auto;
    top: auto;
    right: 0;
    bottom: 0;
  }
  .pg-green,
  .pg-amber,
  .g-run,
  .g-green {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
  }
  .pg-green,
  .g-green {
    background: var(--green);
  }
  .g-run {
    background: var(--blue);
  }
  .pg-amber {
    border-radius: 2px;
    background: var(--amber);
  }

  .card,
  .wt,
  .cc {
    border: 1px solid var(--line);
    background: var(--box);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: var(--card-w);
    height: 3.4rem;
    padding: 0.45rem 0.5rem;
    border-radius: 0.55rem;
  }
  .label-chip {
    align-self: flex-start;
    padding: 0 0.3rem;
    border: 1px solid color-mix(in srgb, var(--blue) 50%, transparent);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--blue) 14%, var(--panel));
    color: color-mix(in srgb, var(--blue) 60%, var(--ink));
    font: 0.6875rem/1.05rem var(--font-mono);
    white-space: nowrap;
  }
  .txt {
    display: block;
    width: 82%;
    height: 3px;
    border-radius: 2px;
    background: var(--struct-dim);
  }
  .txt.short {
    width: 52%;
  }
  .wt {
    width: var(--wt-w);
    height: 3.7rem;
    border-radius: 0.55rem;
  }
  .term {
    position: absolute;
    inset: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    background: var(--panel);
  }
  .code {
    display: block;
    width: 52%;
    height: 2px;
    border-radius: 1px;
    background: var(--code);
  }
  .code.long {
    width: 76%;
  }
  .cursor {
    display: block;
    width: 0.45rem;
    height: 0.6rem;
    background: var(--ink-muted);
  }
  .lit {
    position: absolute;
    inset: -1px;
    border: 1px solid color-mix(in srgb, var(--blue) 75%, transparent);
    border-radius: 0.55rem;
    opacity: 0;
  }

  .merge {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--code);
    border-radius: 50%;
    background: var(--bg);
  }
  .mg-green {
    position: absolute;
    inset: -2px;
    border: 2px solid var(--green);
    border-radius: 50%;
    background: var(--bg);
  }
  .mg-green::after {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--green);
  }
  /* rasterised at full size, scaled down — crisp at the end of the pulse */
  .land,
  .flare,
  .ping {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
  }
  .land {
    left: 50%;
    top: 50%;
    width: 2.9rem;
    height: 2.9rem;
    margin: -1.45rem 0 0 -1.45rem;
    border: 2px solid var(--green);
    box-shadow: 0 0 0.5rem color-mix(in srgb, var(--green) 45%, transparent);
  }
  .flare {
    width: 1.8rem;
    height: 1.8rem;
    margin: -0.9rem 0 0 -0.9rem;
    border: 1.5px solid var(--green);
    box-shadow: 0 0 0.4rem color-mix(in srgb, var(--green) 40%, transparent);
  }

  .cc-at {
    --c: var(--c-cc);
    translate: calc(var(--ax) * -50% + var(--ay) * -100%) calc(var(--ay) * -50% + var(--ax) * -100%);
  }
  .cc {
    --stem: calc(var(--c-rail) - var(--post) - var(--c-cc));
    position: relative;
    display: block;
    width: 5rem;
    height: 3.3rem;
    padding: 0.35rem 0.4rem;
    border-radius: 0.45rem;
  }
  .cc-h {
    display: block;
    color: color-mix(in srgb, var(--ink-muted) 70%, var(--ink-dim));
    font: 0.6875rem/1rem var(--font-mono);
    white-space: nowrap;
  }
  .cc-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 2.4rem;
    margin-top: 0.35rem;
  }
  .scan {
    position: absolute;
    left: -0.15rem;
    right: -0.15rem;
    top: -0.2rem;
    height: 1px;
    background: color-mix(in srgb, var(--ink-muted) 60%, transparent);
    opacity: 0;
  }
  .verdict {
    position: absolute;
    right: 0.75rem;
    bottom: 0.55rem;
    width: 0.9rem;
    height: 0.9rem;
  }
  .verdict i {
    position: absolute;
    left: 0.28rem;
    top: 0;
    width: 0.38rem;
    height: 0.7rem;
    border-right: 2.5px solid var(--green);
    border-bottom: 2.5px solid var(--green);
    transform: rotate(45deg);
    filter: drop-shadow(0 0 0.2rem color-mix(in srgb, var(--green) 60%, transparent));
  }
  .cc-stem {
    position: absolute;
    left: calc(var(--ax) * 50% + var(--ay) * 100%);
    top: calc(var(--ay) * 50% + var(--ax) * 100%);
    width: calc(var(--ax) * 1px + var(--ay) * var(--stem));
    height: calc(var(--ay) * 1px + var(--ax) * var(--stem));
    background: repeating-linear-gradient(var(--cross-dir), var(--line) 0 3px, transparent 3px 6px);
  }

  .diffs {
    --p0: var(--p-plan);
    --o0: calc(var(--g) + 1.1rem);
    --p1: var(--p-checks);
    --o1: calc(var(--g) - 0.7rem);
    --c0: var(--c-diff0);
    --c1: var(--c-diff1);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
  }
  .diff {
    display: block;
    width: 80%;
    max-width: 6.5rem;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--blue) 70%, transparent);
    transform-origin: left center;
  }
  .d2 {
    width: 58%;
    max-width: 4.75rem;
  }
  .d3 {
    width: 70%;
    max-width: 5.75rem;
  }
  .d4 {
    width: 44%;
    max-width: 3.5rem;
  }
  /* sweeps the four centred diff lines (plus a little margin) top → bottom:
     translateY(100%) of its own height, so it fits every layout */
  .diff-scan {
    --stack: calc(4 * 2px + 3 * 0.3rem + 0.4rem);
    position: absolute;
    left: -0.15rem;
    top: 50%;
    width: calc(80% + 0.3rem);
    max-width: 6.8rem;
    height: var(--stack);
    margin-top: calc(var(--stack) / -2);
    border-top: 1px solid color-mix(in srgb, var(--ink-muted) 60%, transparent);
    opacity: 0;
  }

  /* ---------- tokens ---------- */
  .tok {
    --d: 0.75rem;
    opacity: 0;
  }
  .tok .dot {
    background: var(--blue);
    box-shadow: 0 0 0.55rem color-mix(in srgb, var(--blue) 65%, transparent);
  }
  .ghost {
    --d: var(--d-ghost);
    transform: translate(calc(var(--x) * var(--rest)), calc(var(--y) * var(--rest)));
  }
  .ghost .dot {
    background: color-mix(in srgb, var(--blue) 75%, transparent);
  }
  .blocked {
    --d: 0.625rem;
    transform: translate(calc(var(--x) * var(--p-brest)), calc(var(--y) * var(--p-brest)));
  }
  .blocked .dot {
    background: color-mix(in srgb, var(--blue) 60%, transparent);
  }
  .blocked .amber {
    background: var(--amber);
    box-shadow: 0 0 0.5rem color-mix(in srgb, var(--amber) 60%, transparent);
  }
  .ping {
    left: calc(var(--ay) * var(--d) / 2);
    top: calc(var(--ax) * var(--d) / 2);
    width: var(--ping);
    height: var(--ping);
    margin: calc(var(--ping) / -2) 0 0 calc(var(--ping) / -2);
    border: 1.5px solid var(--amber);
  }
  .needs-at {
    --p: var(--p-brest);
    --c: var(--c-chip);
    translate: calc(var(--ax) * -50%) calc(var(--ay) * -50%);
  }
  .needs {
    display: block;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--amber);
    border-radius: 999px;
    background: color-mix(in srgb, var(--amber) 14%, var(--panel));
    color: var(--amber);
    font: 0.6875rem/1rem var(--font-mono);
    white-space: nowrap;
    box-shadow: 0 0 0.6rem color-mix(in srgb, var(--amber) 30%, transparent);
  }

  .lbl {
    --c: var(--c-lbl);
    translate: calc(var(--ax) * -50%) calc(var(--ay) * -50%);
    color: var(--ink-muted);
    font: var(--lbl-size)/1rem var(--font-mono);
    white-space: nowrap;
  }

  /* ---------- narrow panel (< 34.8rem ≈ a 40em viewport at any font
     size): the same stage, top → bottom ---------- */
  @container pipe (max-width: 34.8rem) {
    .stage {
      --ax: 0;
      --ay: 1;
      --p-wt: 0.25;
      --p-plan: 0.47;
      --p-work: 0.6;
      --p-checks: 0.7;
      --p-review: 0.817;
      --c-l1: 0.35rem;
      --c-l2: 1rem;
      --c-l3: 1.65rem;
      --c-l4: 2.3rem;
      --c-rail: 9.7rem;
      --c-lbl: calc(var(--c-rail) + 4.2rem);
      --c-cc: calc(var(--c-rail) - 1.75rem); /* ~6px clear of lane 4's tick */
      --c-diff0: calc(var(--c-rail) + 0.9rem);
      --c-diff1: calc(var(--c-lbl) - 0.5rem); /* stops short of the labels */
      --lbl-size: 0.6875rem;
      --d-ghost: 0.45rem;
      --tick: 0.25rem;
      --ping: 1.1rem; /* stays clear of the neighbouring lane */
      --lane-dir: to bottom;
      --cross-dir: to right;
      width: 17.5rem;
      max-width: 100%;
      height: 22rem;
      margin-inline: auto;
    }
    .frame {
      top: 1.9rem;
      bottom: 1rem;
      left: 0;
      right: 0;
    }
  }

  /* ---------- compact vertical (panel < 17.5rem: 320px phones, or 390px
     at a 20px root font): tighter cross axis, the clean copy and the chip
     wrap to two lines, so every label stays inside the panel ---------- */
  @container pipe (max-width: 17.5rem) {
    .stage {
      --post: 0.9rem;
      --wt-w: 7rem;
      --c-l1: 0.3rem;
      --c-l2: 0.85rem;
      --c-l3: 1.4rem;
      --c-l4: 1.95rem;
      --c-rail: 7.22rem;
      --c-lbl: calc(var(--c-rail) + 3.85rem);
      --c-cc: calc(var(--c-rail) - 1.5rem);
      --c-chip: calc(var(--c-l4) + 0.7rem);
      --c-diff0: calc(var(--c-rail) + 0.7rem);
      --d-ghost: 0.4rem;
      --tick: 0.22rem;
      --ping: 1rem;
      width: 14.4rem;
    }
    .cc {
      width: 3.2rem;
      height: 4.1rem;
      padding: 0.35rem 0.3rem;
    }
    .cc-h,
    .needs {
      white-space: normal;
    }
    .cc-body {
      width: 1.3rem;
    }
    .verdict {
      right: 0.3rem;
      bottom: 0.4rem;
    }
    .needs {
      width: min-content;
      padding: 0.15rem 0.45rem;
      border-radius: 0.6rem;
      text-align: center;
    }
  }

  /* ---------- captions: stacked in one cell, height = tallest ---------- */
  .caption {
    display: grid;
    margin-top: clamp(0.7rem, 2vw, 1.1rem);
    text-align: center;
  }
  .beat {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    max-width: 44rem;
    opacity: 0;
    color: var(--ink);
    font-size: clamp(1.05rem, 2.6vw, 1.25rem);
    line-height: 1.4;
  }

  .beat-list {
    display: none;
    gap: 0.5rem;
    margin: clamp(1rem, 3vw, 1.5rem) 0 0;
    padding-left: 1.4rem;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.4;
  }

  /* ============================================================
     Motion. Base styles above ARE the reduced-motion summary pose;
     animations exist only when motion is welcome.
     ============================================================ */
  @media (prefers-reduced-motion: no-preference) {
    /* "m" = on the shared 17s master clock; each element below only names
       its keyframes (plus a stagger delay for the diff lines) */
    .m {
      animation-duration: 17s;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    /* ambient, own clocks */
    .pip {
      animation: pa-pip 1.8s ease-in-out infinite;
    }
    .cursor {
      animation: pa-blink 1.1s linear infinite;
    }
    .ghost {
      animation: pa-ghost var(--dur) linear var(--lag) infinite;
    }

    /* master timeline */
    .label-chip {
      animation-name: pa-stamp;
    }
    .lit-issue {
      animation-name: pa-lit-issue;
    }
    .lit-wt {
      animation-name: pa-lit-wt;
    }
    .tok {
      animation-name: pa-hero;
    }
    .lanes {
      animation-name: pa-lanes;
    }
    .pg-amber {
      animation-name: pa-plan-amber;
    }
    .pg-green {
      animation-name: pa-plan-green;
    }
    .half {
      animation-name: pa-plan-open;
    }
    .cc {
      animation-name: pa-cc;
    }
    .scan {
      animation-name: pa-scan;
    }
    .verdict {
      animation-name: pa-verdict;
    }
    .diff {
      animation-name: pa-diff;
    }
    .d2 {
      animation-delay: 0.2s;
    }
    .d3 {
      animation-delay: 0.4s;
    }
    .d4 {
      animation-delay: 0.6s;
    }
    .diff-scan {
      animation-name: pa-diff-scan;
    }
    .run-checks {
      animation-name: pa-run-checks;
    }
    .run-review {
      animation-name: pa-run-review;
    }
    .g-checks {
      animation-name: pa-checks-green;
    }
    .flare-checks {
      animation-name: pa-checks-flare;
    }
    .g-review {
      animation-name: pa-review-green;
    }
    .flare-review {
      animation-name: pa-review-flare;
    }
    .mg-green {
      animation-name: pa-merge;
    }
    .land {
      animation-name: pa-land;
    }
    .blocked {
      animation-name: pa-block;
    }
    .blocked .amber {
      animation-name: pa-block-amber;
    }
    .ping {
      animation-name: pa-ping;
    }
    .needs {
      animation-name: pa-needs;
    }
    .beat-1 {
      animation-name: pa-cap1;
    }
    .beat-2 {
      animation-name: pa-cap2;
    }
    .beat-3 {
      animation-name: pa-cap3;
    }
    .beat-4 {
      animation-name: pa-cap4;
    }
    .beat-5 {
      animation-name: pa-cap5;
    }
    .beat-6 {
      animation-name: pa-cap6;
    }
    .beat-7 {
      animation-name: pa-cap7;
    }
    .beat-8 {
      animation-name: pa-cap8;
    }
    .fill-1 {
      animation-name: pa-seg1;
    }
    .fill-2 {
      animation-name: pa-seg2;
    }
    .fill-3 {
      animation-name: pa-seg3;
    }
    .fill-4 {
      animation-name: pa-seg4;
    }
    .fill-5 {
      animation-name: pa-seg5;
    }
    .fill-6 {
      animation-name: pa-seg6;
    }
    .fill-7 {
      animation-name: pa-seg7;
    }
    .fill-8 {
      animation-name: pa-seg8;
    }
  }

  /* ---------- ambient keyframes ---------- */
  @keyframes pa-pip {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes pa-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
  /* a ghost task glides its lane and merges into the trunk */
  @keyframes pa-ghost {
    0% {
      opacity: 0;
      transform: translate(calc(var(--x) * var(--p-ls)), calc(var(--y) * var(--p-ls)));
    }
    7%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--x), var(--y));
    }
  }

  /* ---------- beat 1–2: issue, worktree ---------- */
  @keyframes pa-stamp {
    0%,
    1% {
      opacity: 0;
      transform: scale(1.12);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    4%,
    96% {
      opacity: 1;
      transform: scale(1);
    }
    99%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  @keyframes pa-lit-issue {
    0%,
    2.5% {
      opacity: 0;
    }
    4.5%,
    10% {
      opacity: 1;
    }
    12.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-lit-wt {
    0%,
    15% {
      opacity: 0;
    }
    17%,
    27.5% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
    }
  }

  /* hero token journey — one real pause (plan gate), a short one to work, a
     hold at checks while CI and review run side by side, then one glide
     through both into the merge */
  @keyframes pa-hero {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    6% {
      opacity: 1;
    }
    9% {
      transform: translate(0, 0);
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    19% {
      transform: translate(calc(var(--x) * var(--p-wt)), calc(var(--y) * var(--p-wt)));
    }
    27% {
      transform: translate(calc(var(--x) * var(--p-wt)), calc(var(--y) * var(--p-wt)));
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }
    35% {
      transform: translate(calc(var(--x) * var(--p-plan)), calc(var(--y) * var(--p-plan)));
    }
    47% {
      transform: translate(calc(var(--x) * var(--p-plan)), calc(var(--y) * var(--p-plan)));
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    52% {
      transform: translate(calc(var(--x) * var(--p-work)), calc(var(--y) * var(--p-work)));
    }
    56% {
      transform: translate(calc(var(--x) * var(--p-work)), calc(var(--y) * var(--p-work)));
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    59% {
      transform: translate(calc(var(--x) * var(--p-checks)), calc(var(--y) * var(--p-checks)));
    }
    67% {
      transform: translate(calc(var(--x) * var(--p-checks)), calc(var(--y) * var(--p-checks)));
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    76.5% {
      opacity: 1;
      transform: translate(var(--x), var(--y));
    }
    78%,
    100% {
      opacity: 0;
      transform: translate(var(--x), var(--y));
    }
  }

  /* ---------- beat 3: lanes brighten ---------- */
  @keyframes pa-lanes {
    0%,
    20% {
      opacity: 0.6;
    }
    23.5%,
    27% {
      opacity: 1;
    }
    31%,
    100% {
      opacity: 0.6;
    }
  }

  /* ---------- beat 4: plan gate + clean-copy reviewer ---------- */
  @keyframes pa-plan-amber {
    0%,
    33.5% {
      opacity: 0;
    }
    35%,
    42.5% {
      opacity: 1;
    }
    44%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-plan-green {
    0%,
    42.5% {
      opacity: 0;
    }
    44%,
    80% {
      opacity: 1;
    }
    83.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-plan-open {
    0%,
    45.5% {
      transform: translate(0, 0);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    47%,
    80% {
      transform: translate(
        calc(var(--ay) * var(--dir) * 0.5rem),
        calc(var(--ax) * var(--dir) * 0.5rem)
      );
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    83.5%,
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes pa-cc {
    0%,
    34% {
      opacity: 0;
      transform: translate(calc(var(--ay) * -0.4rem), calc(var(--ax) * -0.4rem));
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    36.5%,
    44% {
      opacity: 1;
      transform: translate(0, 0);
    }
    45.5%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
  }
  @keyframes pa-scan {
    0%,
    36.5% {
      opacity: 0;
      transform: translateY(0);
    }
    37% {
      opacity: 1;
    }
    39.5% {
      opacity: 1;
    }
    40%,
    100% {
      opacity: 0;
      transform: translateY(1.35rem);
    }
  }
  @keyframes pa-verdict {
    0%,
    40% {
      opacity: 0;
      transform: scale(1.6);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    42%,
    44% {
      opacity: 1;
      transform: scale(1);
    }
    45.5%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  /* ---------- beat 5: diff lines draw in from their start edge ---------- */
  @keyframes pa-diff {
    0%,
    49% {
      opacity: 0;
      transform: scaleX(0);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    49.5% {
      opacity: 1;
    }
    53.5%,
    84% {
      opacity: 1;
      transform: scaleX(1);
    }
    86.5%,
    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  /* ---------- beat 6: on the push, checks and review run at once (blue,
     pulsing in step) while the scan reads the diff; review clears green
     first, then checks — only then does the token move on ---------- */
  @keyframes pa-diff-scan {
    0%,
    59% {
      opacity: 0;
      transform: translateY(0);
    }
    59.5% {
      opacity: 1;
    }
    62% {
      opacity: 1;
    }
    62.5%,
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
  }
  @keyframes pa-run-review {
    0%,
    58.5% {
      opacity: 0;
    }
    59.5% {
      opacity: 1;
    }
    61% {
      opacity: 0.45;
    }
    62.5% {
      opacity: 1;
    }
    63.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-run-checks {
    0%,
    58.5% {
      opacity: 0;
    }
    59.5% {
      opacity: 1;
    }
    61% {
      opacity: 0.45;
    }
    62.5% {
      opacity: 1;
    }
    64% {
      opacity: 0.45;
    }
    65.5% {
      opacity: 1;
    }
    66.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-review-green {
    0%,
    62.5% {
      opacity: 0;
    }
    63.5%,
    80% {
      opacity: 1;
    }
    83.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-review-flare {
    0%,
    62.5% {
      opacity: 0;
      transform: scale(0.4);
    }
    63.5% {
      opacity: 1;
      transform: scale(0.75);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    66.5%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  @keyframes pa-checks-green {
    0%,
    65.5% {
      opacity: 0;
    }
    66.5%,
    80% {
      opacity: 1;
    }
    83.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-checks-flare {
    0%,
    65.5% {
      opacity: 0;
      transform: scale(0.4);
    }
    66.5% {
      opacity: 1;
      transform: scale(0.75);
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }
    69.5%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  /* ---------- beat 7: lands on the trunk with a green pulse ---------- */
  @keyframes pa-merge {
    0%,
    74.5% {
      opacity: 0;
    }
    76%,
    97% {
      opacity: 1;
    }
    99.5%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pa-land {
    0%,
    74.5% {
      opacity: 0;
      transform: scale(0.38);
    }
    75.5% {
      opacity: 1;
      transform: scale(0.45);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    86%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  /* ---------- beat 8: blocked task bounces, turns amber, asks ---------- */
  @keyframes pa-block {
    0%,
