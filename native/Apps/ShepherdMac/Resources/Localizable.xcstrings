          "stringUnit": {
            "state": "translated",
            "value": "Prüfung hat Änderungen angefordert und Shepherd markiert diesen Plan als blockiert. Setze den Planner mit den Befunden fort oder verwirf den Stall, um selbst zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
