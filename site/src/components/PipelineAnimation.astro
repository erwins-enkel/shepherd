<script>
  // Hold the story at beat 1 until it can be seen, restart it from 0 each
  // time it comes back into view, rewind and pause it while hidden. Pure
  // enhancement: with JS disabled the CSS animation just plays from load.
  //
  // Measured on this figure: while an IntersectionObserver had a target
  // attached, Chromium ran a main-thread style + prepaint pass on every frame
  // the compositor animation ticked, undoing the compositor-only loop. So the
  // observer only watches for entry while the story is paused — entry = the
  // caption fully in view, so beat 1 is actually read — and while it plays a
  // passive check watches for the figure leaving view. That exit is only
  // noticed on scroll or resize.
  const fig = document.querySelector<HTMLElement>(".pipe");
  const cap = fig?.querySelector<HTMLElement>(".caption");
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  function player(fig: HTMLElement, cap: HTMLElement) {
    const each = (fn: (a: Animation) => void) =>
      fig.getAnimations({ subtree: true }).forEach(fn);
    // paused on beat 1, so a figure coming back into view never shows a
    // frozen mid-story frame
    const hold = () =>
      each((a) => {
        a.pause();
        a.currentTime = 0;
      });
    // strict, like the observer: an edge-adjacent figure still counts as in view
    const hidden = () => {
      const r = fig.getBoundingClientRect();
      return r.bottom < 0 || r.top > innerHeight;
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.intersectionRatio > 0.99)) start();
      },
      { threshold: 1 },
    );
    const onMove = () => {
      if (hidden()) stop();
    };
    const start = () => {
      io.disconnect();
      each((a) => {
        a.currentTime = 0;
        a.play();
      });
      addEventListener("scroll", onMove, { passive: true });
      addEventListener("resize", onMove);
    };
    const stop = () => {
      removeEventListener("scroll", onMove);
      removeEventListener("resize", onMove);
      hold();
      io.observe(cap);
    };

    hold();
    io.observe(cap);
  }

  if (fig && cap && "IntersectionObserver" in window) {
    // Reduced motion: nothing animates, so nothing to manage — unless the OS
    // setting flips mid-session, which creates the animations.
    if (!still.matches) player(fig, cap);
    else still.addEventListener("change", () => player(fig, cap), { once: true });
  }
</script>
