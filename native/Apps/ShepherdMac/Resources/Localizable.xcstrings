    "diagnostics_fix_action_claude_trust": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd markiert diesen Repo-Ordner als vertrauenswürdig für Claude Code, damit die Nutzungsanzeige ihn lesen kann. Es wird kein Befehl ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd will mark this repo folder as trusted for Claude Code so the usage gauge can read it. No command runs."
          }
        }
      }
    },
    "diagnostics_fix_action_host_capacity": {
      "comment": "%1$@ = memoryHigh, %2$@ = cpuQuota, %3$@ = units",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd setzt MemoryHigh=%1$@ und CPUQuota=%2$@ für diese Units: %3$@. Das wendet ein sofort wirksames, dauerhaftes Limit an — ohne Neustart, ohne unterbrochene Sessions. Es begrenzt jede Unit für sich; für eine gemeinsame Obergrenze über Shepherd und herdr richte eine shepherd.slice ein (siehe „So behebst du das“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherd will set MemoryHigh=%1$@ and CPUQuota=%2$@ on these units: %3$@. This applies a live, persistent limit — no restart, no interrupted sessions. It bounds each unit on its own; for one shared cap across Shepherd and herdr, set up a shepherd.slice (see How to fix)."
          }
        }
      }
    },
    "diagnostics_fix_action_tmp_inodes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shepherds freigebbare Caches jetzt aus dem temporären Dateisystem räumen, unabhängig vom üblichen Schwellenwert. Das entfernt den Compile-Cache und veraltete Tool-Caches. Paketmanager-Stores und von Agents zurückgelassene Worktrees werden noch nicht freigegeben, die Auslastung kann also hoch bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep Shepherd's reclaimable caches from the temporary filesystem now, ignoring the usual usage threshold. This drops the compile cache and stale tool caches. Package-manager stores and leftover worktrees left behind by agents are not reclaimed yet, so usage may stay high."
          }
        }
      }
    },
    "diagnostics_fix_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
