"diagnostics_hint_tailscale_serve_denied" = "Tailscale verweigert Shepherd die serve-Konfiguration, dadurch lässt sich keine Live-Vorschau veröffentlichen — führe einmalig sudo tailscale set --operator=$USER aus und prüfe die Checks erneut.";
"diagnostics_hint_tmp_entries_critical" = "Das temporäre Dateisystem ist stark mit Überbleibseln zugesetzt — weit jenseits der Schwelle, ab der Shepherd aufräumt. Verzeichnis-Scans werden langsam, und die [[inode|Inodes]] können ausgehen, obwohl Speicherplatz frei aussieht. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann.";
"diagnostics_hint_tmp_entries_high" = "Im temporären Dateisystem sammeln sich Überbleibsel an. Es vergibt [[inode|Inodes]] dynamisch, deshalb beobachtet Shepherd die Anzahl statt einer Auslastung in Prozent. Unbeachtet verlangsamt das jeden Verzeichnis-Scan und kann die [[inode|Inodes]] trotzdem aufbrauchen. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann.";
"diagnostics_hint_tmp_entries_ok" = "Das temporäre Dateisystem vergibt [[inode|Inodes]] dynamisch — eine Auslastung in Prozent gibt es dort nicht. Shepherd beobachtet stattdessen, wie viele Überbleibsel sich ansammeln. Aktuell unbedenklich wenige.";
"diagnostics_hint_tmp_inodes_critical" = "Im temporären Dateisystem sind die [[inode|Inodes]] fast aufgebraucht. Neue Agent-Sessions werden mit „kein Speicherplatz“-Fehlern scheitern, obwohl Speicherplatz frei aussieht. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann.";
"diagnostics_hint_tmp_inodes_high" = "Im temporären Dateisystem werden die [[inode|Inodes]] knapp — es kann volllaufen, obwohl noch Speicherplatz frei ist, und Agent-Sessions scheitern dann mit irreführenden „kein Speicherplatz“-Fehlern. „Beheben“ räumt die Caches auf, die Shepherd freigeben kann.";
"diagnostics_hint_tmp_inodes_ok" = "Das temporäre Dateisystem hat reichlich freie [[inode|Inodes]].";
"diagnostics_hint_tmp_inodes_uninspectable" = "Shepherd kann die [[inode|Inode]]-Auslastung des temporären Dateisystems auf diesem System nicht auslesen.";
